# Read by `docker compose` (copy to `.env`; it's git-ignored).
# Password of MongoDB's root user `zaps`, set when the volume is first created. Hex, so it's URI-safe.
# Generate with: node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
# Use the same value in server/.env → MONGODB_URI.
MONGO_ROOT_PASSWORD=replace-me
